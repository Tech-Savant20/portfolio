---
import { certifications, education, leadership } from "../data/credentials";
import DealerHands from "./DealerHands.astro";
import Icon from "./Icon.astro";
---

<section id="credentials" class="section creds" aria-labelledby="creds-title" data-section="credentials">
  <div class="container-x">
    <h2 id="creds-title" class="section-title head" data-reveal data-split>Credentials</h2>

    <div class="certs" data-deck-root>
      <div class="deck-head">
        <h3 class="col-title">Certifications</h3>
        <p class="hint" data-deck-hint>{certifications.length} certifications</p>
        {/* Only shown once the deck is live; without motion the cards simply lie face up. */}
        <div class="controls" data-deck-controls>
          <button type="button" class="btn btn-ghost ctl" data-deck-shuffle>
            <Icon name="shuffle" size="1rem" />
            Shuffle again
          </button>
          <button type="button" class="btn btn-ghost ctl" data-deck-reveal>
            <Icon name="eye" size="1rem" />
            Reveal all
          </button>
          <button type="button" class="sound" data-deck-sound aria-pressed="true" aria-label="Shuffle sound" title="Shuffle sound">
            <Icon name="speaker-high" size="1.05rem" class="on" />
            <Icon name="speaker-slash" size="1.05rem" class="off" />
          </button>
        </div>
      </div>

      <div class="deck" data-deck>
      <ul class="pile" data-pile>
        {
          certifications.map((c, i) => (
            <li class="card" data-card>
              <div class="inner" data-card-inner>
                <div class="face">
                  <span class="index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                  <span class="logo" aria-hidden="true">
                    <Icon name={c.icon} set="brand" size="2rem" />
                  </span>
                  <span class="name">{c.name}</span>
                  <span class="issuer">{c.issuer}</span>
                  {c.date && <span class="date">{c.date}</span>}
                  <a class="verify" href={c.href} target="_blank" rel="noopener">
                    Verify
                    <Icon name="arrow-up-right" size="0.85rem" />
                    <span class="sr-only">{c.name} (opens in a new tab)</span>
                  </a>
                  <span class="index corner" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                </div>
                <div class="back" aria-hidden="true">
                  <span class="mono">AT</span>
                </div>
              </div>
              <button type="button" class="flip" data-card-flip aria-pressed="true">
                <span class="sr-only">Flip {c.name}</span>
              </button>
            </li>
          ))
        }
      </ul>
      <DealerHands />
      </div>
    </div>

    <div class="side">
      <div class="block" data-reveal>
        <h3 class="col-title">Education</h3>
        <p class="big">{education.school}</p>
        <p>{education.degree}</p>
        <p class="meta" data-scramble>{education.period}</p>
        <p class="grade">{education.grade}</p>
        <p class="school">{education.schooling.join(". ")}.</p>
      </div>

      <div class="block" data-reveal style="--reveal-delay:80ms">
        <h3 class="col-title">Leadership</h3>
        <p class="big">{leadership.title}</p>
        <p>{leadership.org}</p>
        <p class="meta" data-scramble>{leadership.period}</p>
        <ul class="points">
          {leadership.points.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .head {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .col-title {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--fg-muted);
  }

  /* ------------------------------------------------------------------ deck */

  .certs {
    --card-w: clamp(9.25rem, 15vw, 13.25rem);
    --hand-w: calc(var(--card-w) * 0.95);
    margin-bottom: clamp(3.5rem, 7vw, 6rem);
  }

  .deck-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-bottom: 1.75rem;
  }

  .hint {
    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  .controls {
    display: none;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  .deck-ready .controls {
    display: flex;
  }

  .ctl {
    height: 2.5rem;
    padding-inline: 1rem;
    font-size: 0.875rem;
  }

  .ctl[disabled] {
    opacity: 0.45;
    pointer-events: none;
  }

  .sound {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--fg-muted);
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .sound:hover {
    color: var(--fg);
    border-color: var(--fg-subtle);
  }

  .sound :global(svg) {
    grid-area: 1 / 1;
  }

  .sound[aria-pressed="true"] :global(.off),
  .sound[aria-pressed="false"] :global(.on) {
    display: none;
  }

  /* Without the script (or with reduced motion) the certificates lie face up in a row. */
  .pile {
    display: grid;
    grid-template-columns: repeat(auto-fill, var(--card-w));
    justify-content: center;
    gap: 1rem;
    list-style: none;
    padding: 0;
  }

  .card {
    position: relative;
    aspect-ratio: 5 / 7;
    perspective: 1100px;
  }

  /* Live deck: a stage (the table) of absolutely placed cards and hands that the script moves. */
  .deck-ready .deck {
    position: relative;
    isolation: isolate;
    border-bottom: 1px solid var(--line);
  }

  .deck-ready .pile {
    display: block;
  }

  .deck-ready .card {
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--card-w);
    margin-left: calc(var(--card-w) / -2);
  }

  .inner {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    /* Clicks fall through to the flip button underneath; the Verify link opts back in. */
    pointer-events: none;
  }

  .face,
  .back {
    position: absolute;
    inset: 0;
    border-radius: 14px;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    box-shadow: var(--shadow);
  }

  .face {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.1rem 1.1rem 1rem;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    overflow: hidden;
  }

  /* Orange edge so the face reads as the "lit" side when it turns over. */
  .face::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--accent);
  }

  .index {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--fg-subtle);
  }

  .corner {
    position: absolute;
    right: 0.9rem;
    bottom: 0.75rem;
    transform: rotate(180deg);
  }

  .logo {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin: 0.35rem 0 0.5rem;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--fg);
  }

  .name {
    font-weight: 650;
    font-size: clamp(0.9375rem, 1.15vw, 1.0625rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .issuer {
    font-size: 0.8125rem;
    color: var(--fg-muted);
    line-height: 1.3;
  }

  .date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-muted);
  }

  .verify {
    position: relative;
    z-index: 3;
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    width: fit-content;
    height: 2rem;
    margin-top: auto;
    padding-inline: 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    font-size: 0.75rem;
    font-weight: 550;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .verify:hover {
    border-color: var(--accent-ink);
    color: var(--accent-ink);
  }

  /* Face down: the link is on the hidden side, so it can't be hit through the back. */
  .card:global(.is-down) .verify {
    pointer-events: none;
  }

  .back {
    display: grid;
    place-items: center;
    transform: rotateY(180deg);
    /* Dark in both themes, like a real deck. */
    background:
      repeating-linear-gradient(45deg, rgb(255 90 31 / 0.07) 0 2px, transparent 2px 10px),
      #141416;
    border: 1px solid #2a2a2e;
  }

  .back::before {
    content: "";
    position: absolute;
    inset: 0.55rem;
    border-radius: 9px;
    border: 1px solid rgb(255 90 31 / 0.55);
  }

  .mono {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 999px;
    border: 1px solid rgb(255 90 31 / 0.7);
    background: #141416;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #ff5a1f;
  }

  /* Nothing to flip unless the deck is live. */
  .flip {
    display: none;
  }

  .deck-ready .flip {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 1;
    border: 0;
    border-radius: 14px;
    background: transparent;
    cursor: pointer;
  }

  /* The button sits under the card art, so its focus ring goes on the card. */
  .card:has(.flip:focus-visible) {
    outline: 2px solid var(--accent-ink);
    outline-offset: 5px;
    border-radius: 16px;
  }

  .deck-ready .card:hover .face,
  .deck-ready .card:hover .back {
    box-shadow:
      0 0 0 1px var(--accent),
      var(--shadow);
  }

  /* -------------------------------------------------- education, leadership */

  .side {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem clamp(2rem, 5vw, 5rem);
  }

  .side .col-title {
    margin-bottom: 1.25rem;
  }

  .block {
    display: grid;
    gap: 0.25rem;
    align-content: start;
  }

  .big {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .grade {
    margin-top: 0.75rem;
    font-weight: 600;
  }

  .school,
  .block > p:not(.big):not(.grade):not(.meta) {
    color: var(--fg-muted);
  }

  .school {
    font-size: 0.875rem;
  }

  .points {
    margin-top: 0.75rem;
    display: grid;
    gap: 0.5rem;
    padding-left: 1.1rem;
    list-style: disc;
    color: var(--fg-muted);
  }

  .points li::marker {
    color: var(--accent);
  }

  @media (max-width: 767px) {
    .certs {
      --card-w: min(10.5rem, 42vw);
    }

    .controls {
      margin-left: 0;
      flex-wrap: wrap;
    }

    .side {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
