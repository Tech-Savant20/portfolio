---
import { certifications, education, leadership } from "../data/credentials";
import Icon from "./Icon.astro";
---

<section id="credentials" class="section creds" aria-labelledby="creds-title" data-section="credentials">
  <div class="container-x">
    <h2 id="creds-title" class="section-title head" data-reveal data-split>Credentials</h2>
    <div class="layout">
      <div class="certs" data-reveal>
        <h3 class="col-title">Certifications</h3>
        <ul>
          {
            certifications.map((c) => (
              <li>
                <span class="logo" aria-hidden="true">
                  <Icon name={c.icon} set="brand" size="1.25rem" />
                </span>
                <span class="what">
                  <span class="name">{c.name}</span>
                  <span class="issuer">{c.date ? `${c.issuer}, ${c.date}` : c.issuer}</span>
                </span>
                <a class="verify" href={c.href} target="_blank" rel="noopener">
                  Verify
                  <Icon name="arrow-up-right" size="0.9rem" />
                  <span class="sr-only">{c.name} (opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="side">
        <div class="block" data-reveal style="--reveal-delay:80ms">
          <h3 class="col-title">Education</h3>
          <p class="big">{education.school}</p>
          <p>{education.degree}</p>
          <p class="meta" data-scramble>{education.period}</p>
          <p class="grade">{education.grade}</p>
          <p class="school">{education.schooling.join(". ")}.</p>
        </div>

        <div class="block" data-reveal style="--reveal-delay:160ms">
          <h3 class="col-title">Leadership</h3>
          <p class="big">{leadership.title}</p>
          <p>{leadership.org}</p>
          <p class="meta" data-scramble>{leadership.period}</p>
          <ul class="points">
            {leadership.points.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .head {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 5rem);
  }

  .col-title {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--fg-muted);
    margin-bottom: 1.25rem;
  }

  .certs ul {
    display: grid;
    gap: 0.625rem;
    list-style: none;
    padding: 0;
  }

  .certs li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .logo {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid var(--line);
  }

  .what {
    display: grid;
    gap: 0.125rem;
  }

  .name {
    font-weight: 600;
    line-height: 1.3;
  }

  .issuer {
    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  .verify {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    height: 2.25rem;
    padding-inline: 0.875rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 0.8125rem;
    font-weight: 550;
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .verify:hover {
    background: var(--bg);
    border-color: var(--fg-subtle);
  }

  .side {
    display: grid;
    gap: 3rem;
    align-content: start;
  }

  .block {
    display: grid;
    gap: 0.25rem;
  }

  .big {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
  }

  .grade {
    margin-top: 0.75rem;
    font-weight: 600;
  }

  .school,
  .block > p:not(.big):not(.grade):not(.meta) {
    color: var(--fg-muted);
  }

  .school {
    font-size: 0.875rem;
  }

  .points {
    margin-top: 0.75rem;
    display: grid;
    gap: 0.5rem;
    padding-left: 1.1rem;
    list-style: disc;
    color: var(--fg-muted);
  }

  .points li::marker {
    color: var(--accent);
  }

  @media (max-width: 1023px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 480px) {
    .certs li {
      grid-template-columns: auto 1fr;
    }

    .verify {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
