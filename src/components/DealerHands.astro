---
/**
 * The dealer's hands for the certifications deck: line drawings in a suit,
 * with a Galaxy Watch 4 on the left wrist. Each hand is split in two layers,
 * fingers and palm behind the cards and the thumb in front, so it looks like
 * it is really holding them. src/scripts/hands.ts poses and moves them.
 *
 * All coordinates share one 200 x 420 viewBox; the palm's top centre (100, 60)
 * is the point the script places on the table.
 */

// Pinky to index, left hand (palm down, so the thumb is on the right).
const fingers = [
  { x: 72, len: 50 },
  { x: 91, len: 62 },
  { x: 110, len: 68 },
  { x: 128, len: 62 },
];
const BASE = 66;

// The watch sits on the left wrist.
const WX = 100;
const WY = 168;
const SEC_R = 18.5;
const SEC_C = 2 * Math.PI * SEC_R;
---

{/* Back layer: sleeves, palms and fingers, under the cards. */}
<div class="hands hands-back" data-hands-back>
  {
    (["left", "right"] as const).map((side) => (
      <div class:list={["hand", side]} data-hand={`${side}-back`}>
        <svg viewBox="0 0 200 420" aria-hidden="true">
          <g transform={side === "right" ? "translate(200 0) scale(-1 1)" : undefined}>
            {/* Runs far past the drawing; the stage's bottom edge (the table) cuts it off. */}
            <path class="suit" d="M46 204 L154 204 L196 1600 L4 1600 Z" />
            <path class="suit-seam" d="M100 214 L100 1600" />
            <path class="skin" d="M62 146 L60 190 L140 190 L138 146 Z" />
            {fingers.map((f, i) => (
              <g data-finger={i}>
                <rect class="skin" x={f.x - 9.5} y={BASE - f.len} width="19" height={f.len + 10} rx="9.5" />
                <path class="crease" d={`M${f.x - 5} ${BASE - f.len * 0.42} q5 2.5 10 0`} />
              </g>
            ))}
            <rect class="skin" x="55" y="56" width="90" height="104" rx="28" />
            <path class="crease" d="M76 72 q24 -7 48 0" />
            <rect class="cuff" x="50" y="182" width="100" height="30" rx="6" />
            <circle class="link" cx="138" cy="197" r="4.6" />
          </g>

          {
            side === "left" && (
              <g class="watch">
                <rect class="strap" x="56" y="156" width="88" height="24" rx="5" />
                <rect class="btn" x="122" y="157" width="5" height="8" rx="2" />
                <rect class="btn" x="122" y="171" width="5" height="8" rx="2" />
                <circle class="case" cx={WX} cy={WY} r="24" />
                <circle class="bezel" cx={WX} cy={WY} r="21.5" />
                <g data-watch-clock>
                  <circle
                    class="sec"
                    cx={WX}
                    cy={WY}
                    r={SEC_R}
                    stroke-dasharray={SEC_C}
                    stroke-dashoffset={SEC_C}
                    transform={`rotate(-90 ${WX} ${WY})`}
                    data-watch-sec
                    data-circ={SEC_C}
                  />
                  <text class="city" x={WX} y={WY - 8}>PUNE</text>
                  <text class="time" x={WX} y={WY + 4} data-watch-time>--:--</text>
                </g>
                {/* The Omnitrix: a green hourglass on a black dial. */}
                <g data-watch-dial opacity="0">
                  <circle class="dial" cx={WX} cy={WY} r="20" />
                  <circle class="dial-ring" cx={WX} cy={WY} r="16.5" />
                  <path class="hourglass" d={`M${WX - 12} ${WY - 13} L${WX + 12} ${WY - 13} L${WX} ${WY} Z M${WX - 12} ${WY + 13} L${WX + 12} ${WY + 13} L${WX} ${WY} Z`} />
                </g>
              </g>
            )
          }
        </svg>
        {
          side === "left" && (
            <button type="button" class="watch-btn" data-watch-btn aria-label="Watch showing the time in Pune. Press to activate the Omnitrix." />
          )
        }
      </div>
    ))
  }
</div>

{/* Front layer: thumbs over the cards, and the hologram. */}
<div class="hands hands-front" data-hands-front aria-hidden="true">
  {
    (["left", "right"] as const).map((side) => (
      <div class:list={["hand", side]} data-hand={`${side}-front`}>
        <svg viewBox="0 0 200 420">
          <g transform={side === "right" ? "translate(200 0) scale(-1 1)" : undefined}>
            <g data-thumb>
              <rect class="skin" x="129" y="58" width="22" height="70" rx="11" />
              <path class="crease" d="M135 84 q5 2 10 0" />
            </g>
          </g>
        </svg>
      </div>
    ))
  }

  <div class="holo" data-holo>
    <svg viewBox="0 0 160 230">
      <defs>
        <linearGradient id="holo-beam" x1="0" y1="1" x2="0" y2="0">
          <stop offset="0" stop-color="#43f24b" stop-opacity="0.5" />
          <stop offset="1" stop-color="#43f24b" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path class="beam" d="M6 228 L28 60 L152 60 L18 228 Z" fill="url(#holo-beam)" />
      <g class="alien" data-alien="0">
        {/* Heatblast: flame head on a rocky body. */}
        <path d="M76 72 L70 44 L81 58 L84 30 L92 54 L100 28 L103 56 L112 40 L106 72 Z" />
        <circle cx="90" cy="80" r="14" />
        <path d="M68 96 L112 96 L107 150 L73 150 Z" />
        <path d="M69 98 L52 136 L60 140 L78 108 Z M111 98 L128 136 L120 140 L102 108 Z" />
        <path d="M75 148 L71 196 L85 196 L88 150 Z M92 150 L95 196 L109 196 L105 148 Z" />
      </g>
      <g class="alien" data-alien="1">
        {/* Four Arms: broad chest, four arms, small head. */}
        <path d="M82 72 L90 60 L98 72 Z" />
        <circle cx="90" cy="84" r="11" />
        <path d="M60 98 L120 98 L112 156 L68 156 Z" />
        <path d="M61 100 L36 76 L30 86 L56 112 Z M119 100 L144 76 L150 86 L124 112 Z" />
        <path d="M64 120 L40 150 L49 156 L72 132 Z M116 120 L140 150 L131 156 L108 132 Z" />
        <path d="M70 154 L66 198 L84 198 L88 156 Z M92 156 L96 198 L114 198 L110 154 Z" />
      </g>
      <g class="alien" data-alien="2">
        {/* XLR8: leaning raptor, long helmet, tail, wheels for feet. */}
        <path d="M58 128 C66 102 104 96 120 108 C112 128 84 140 58 128 Z" />
        <path d="M112 104 C126 88 148 86 154 96 C144 104 128 110 116 112 Z" />
        <path d="M60 126 C42 128 26 140 10 160 C30 148 48 140 66 134 Z" />
        <path d="M84 132 L78 170 L87 170 L93 134 Z M101 128 L104 168 L113 168 L109 128 Z" />
        <circle cx="82" cy="176" r="8" />
        <circle cx="108" cy="174" r="8" />
        <path d="M104 116 L118 132 L113 136 L100 122 Z" />
      </g>
      <text class="holo-name" x="96" y="16" data-holo-name></text>
    </svg>
  </div>
</div>

<style>
  .hands {
    display: none;
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    --skin: #d9a47d;
    --ink: #2a1f18;
    --suit: #1a1a1e;
    --suit-edge: #36363d;
  }

  :global(.deck-ready) .hands {
    display: block;
  }

  /* Under every card, even the ones briefly slipped under the deck. */
  .hands-back {
    z-index: -100;
  }

  .hands-front {
    z-index: 500;
  }

  .hand {
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--hand-w);
    /* Puts the palm's top centre (100, 60 of 200 x 420) on the element's origin. */
    margin-left: calc(var(--hand-w) * -0.5);
    margin-top: calc(var(--hand-w) * -0.3);
    will-change: transform;
  }

  .hand svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .skin {
    fill: var(--skin);
    stroke: var(--ink);
    stroke-width: 2.2;
  }

  .crease {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.3;
    stroke-linecap: round;
    opacity: 0.55;
  }

  .suit {
    fill: var(--suit);
    stroke: var(--suit-edge);
    stroke-width: 2;
  }

  .suit-seam {
    stroke: var(--suit-edge);
    stroke-width: 1.2;
    stroke-dasharray: 3 4;
  }

  .cuff {
    fill: #f4f3ef;
    stroke: #b9b7b0;
    stroke-width: 1.6;
  }

  .link {
    fill: #ff5a1f;
    stroke: #8f2f0b;
    stroke-width: 1;
  }

  .strap {
    fill: #202024;
    stroke: #0e0e10;
    stroke-width: 1.2;
  }

  .btn {
    fill: #2e2e33;
  }

  .case {
    fill: #25252a;
    stroke: #45454c;
    stroke-width: 1.6;
  }

  .bezel {
    fill: #070708;
  }

  .sec {
    fill: none;
    stroke: #ff5a1f;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  .city {
    fill: #9d9da3;
    font-family: var(--font-mono);
    font-size: 4.6px;
    letter-spacing: 1px;
    text-anchor: middle;
  }

  .time {
    fill: #f4f4f1;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    text-anchor: middle;
  }

  .dial {
    fill: #0b0b0b;
    stroke: #505056;
    stroke-width: 3;
  }

  .dial-ring {
    fill: none;
    stroke: #43f24b;
    stroke-width: 1.4;
    opacity: 0.6;
  }

  .hourglass {
    fill: #43f24b;
    filter: drop-shadow(0 0 3px #43f24b);
  }

  .watch-btn {
    position: absolute;
    left: 37%;
    top: 33.8%;
    width: 26%;
    aspect-ratio: 1;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    pointer-events: auto;
  }

  .watch-btn:focus-visible {
    outline: 2px solid #43f24b;
    outline-offset: 2px;
  }

  .holo {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(var(--hand-w) * 0.85);
    opacity: 0;
    visibility: hidden;
    transform-origin: 0% 100%;
    filter: drop-shadow(0 0 8px rgb(67 242 75 / 0.7));
  }

  .holo svg {
    width: 100%;
    height: auto;
    /* Scan lines, cut out of the projection itself so no box shows around it. */
    mask-image: repeating-linear-gradient(to bottom, #000 0 2.6px, rgb(0 0 0 / 0.35) 2.6px 4px);
  }

  .alien {
    fill: #43f24b;
    opacity: 0;
  }

  .holo-name {
    fill: #43f24b;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-anchor: middle;
  }
</style>
