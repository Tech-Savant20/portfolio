---
/**
 * The dealer's hands for the certifications deck: line drawings in a suit,
 * with a Galaxy Watch 4 on the left wrist. Each hand is split in two layers,
 * fingers and palm behind the cards and the thumb in front, so it looks like
 * it is really holding them. src/scripts/hands.ts poses and moves them.
 *
 * All coordinates share one 200 x 420 viewBox; the palm's top centre (100, 60)
 * is the point the script places on the table.
 */

// Pinky to index, left hand (palm down, so the thumb is on the right).
const fingers = [
  { x: 72, len: 50 },
  { x: 91, len: 62 },
  { x: 110, len: 68 },
  { x: 128, len: 62 },
];
const BASE = 66;

/** A tapered finger with a rounded tip, from its base up to `top`. */
const fingerPath = (x: number, top: number) =>
  `M${x - 9} ${BASE + 10} L${x - 8.6} ${top + 9} C${x - 8.6} ${top + 1} ${x - 5} ${top - 2} ${x} ${top - 2} ` +
  `C${x + 5} ${top - 2} ${x + 8.4} ${top + 1} ${x + 8.4} ${top + 9} L${x + 9} ${BASE + 10} Z`;
/** The nail near the tip (we see the back of the hand). */
const nailPath = (x: number, top: number) =>
  `M${x - 5} ${top + 14} L${x - 5} ${top + 6} Q${x - 5} ${top + 2} ${x} ${top + 2} Q${x + 5} ${top + 2} ${x + 5} ${top + 6} ` +
  `L${x + 5} ${top + 14} Q${x} ${top + 16.5} ${x - 5} ${top + 14} Z`;
/** Two wrinkles at each finger joint. */
const jointPath = (x: number, y: number) => `M${x - 5} ${y} q5 2.4 10 0 M${x - 4} ${y + 3} q4 1.8 8 0`;

// The watch sits on the left wrist.
const WX = 100;
const WY = 168;
const SEC_R = 18.5;
const SEC_C = 2 * Math.PI * SEC_R;
---

{/* Back layer: sleeves, palms and fingers, under the cards. */}
<div class="hands hands-back" data-hands-back>
  {
    (["left", "right"] as const).map((side) => (
      <div class:list={["hand", side]} data-hand={`${side}-back`}>
        <svg viewBox="0 0 200 420" aria-hidden="true">
          <defs>
            {/* Lighter down the middle of the hand, warmer at the edges. */}
            <linearGradient id={`skin-${side}-back`} x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#c78c64" />
              <stop offset="0.5" stop-color="#e0ad88" />
              <stop offset="1" stop-color="#c78c64" />
            </linearGradient>
          </defs>
          <g transform={side === "right" ? "translate(200 0) scale(-1 1)" : undefined}>
            {/* Runs far past the drawing; the stage's bottom edge (the table) cuts it off. */}
            <path class="suit" d="M46 204 L154 204 L196 1600 L4 1600 Z" />
            <path class="suit-seam" d="M100 214 L100 1600" />
            <path class="skin" fill={`url(#skin-${side}-back)`} d="M64 146 C62 162 61 176 60 190 L140 190 C139 176 138 162 136 146 Z" />
            {fingers.map((f, i) => {
              const top = BASE - f.len;
              return (
                <g data-finger={i}>
                  <path class="skin" fill={`url(#skin-${side}-back)`} d={fingerPath(f.x, top)} />
                  <path class="nail" d={nailPath(f.x, top)} />
                  <path class="crease" d={jointPath(f.x, top + f.len * 0.36)} />
                  <path class="crease" d={jointPath(f.x, top + f.len * 0.68)} />
                </g>
              );
            })}
            {/* Back of the hand: wide at the knuckles, narrowing to the wrist. */}
            <path
              class="skin"
              fill={`url(#skin-${side}-back)`}
              d="M58 72 C56 61 63 56 72 58 L128 58 C138 57 146 62 144 74 L141 128 C140 146 135 153 124 157 L76 157 C66 153 61 146 59 128 Z"
            />
            {/* Knuckles, and the tendons running down to the wrist. */}
            <path class="crease" d={fingers.map((f) => `M${f.x - 6} 71 q6 -4.5 12 0`).join(" ")} />
            <path class="tendon" d="M72 78 Q84 116 94 146 M91 78 Q96 114 99 146 M110 78 Q106 114 102 146 M128 78 Q116 116 106 146" />
            <rect class="cuff" x="50" y="182" width="100" height="30" rx="6" />
            <circle class="link" cx="138" cy="197" r="4.6" />
          </g>

          {
            side === "left" && (
              <g class="watch">
                <rect class="strap" x="56" y="156" width="88" height="24" rx="5" />
                <rect class="btn" x="122" y="157" width="5" height="8" rx="2" />
                <rect class="btn" x="122" y="171" width="5" height="8" rx="2" />
                <circle class="case" cx={WX} cy={WY} r="24" />
                <circle class="bezel" cx={WX} cy={WY} r="21.5" />
                <g data-watch-clock>
                  <circle
                    class="sec"
                    cx={WX}
                    cy={WY}
                    r={SEC_R}
                    stroke-dasharray={SEC_C}
                    stroke-dashoffset={SEC_C}
                    transform={`rotate(-90 ${WX} ${WY})`}
                    data-watch-sec
                    data-circ={SEC_C}
                  />
                  <text class="city" x={WX} y={WY - 8}>PUNE</text>
                  <text class="time" x={WX} y={WY + 4} data-watch-time>--:--</text>
                </g>
                {/* The Omnitrix: a green hourglass on a black dial. */}
                <g data-watch-dial opacity="0">
                  <circle class="dial" cx={WX} cy={WY} r="20" />
                  <circle class="dial-ring" cx={WX} cy={WY} r="16.5" />
                  <path class="hourglass" d={`M${WX - 12} ${WY - 13} L${WX + 12} ${WY - 13} L${WX} ${WY} Z M${WX - 12} ${WY + 13} L${WX + 12} ${WY + 13} L${WX} ${WY} Z`} />
                </g>
              </g>
            )
          }
        </svg>
        {
          side === "left" && (
            <button type="button" class="watch-btn" data-watch-btn aria-label="Watch showing the time in Pune. Press to activate the Omnitrix." />
          )
        }
      </div>
    ))
  }
</div>

{/* Front layer: thumbs over the cards, and the hologram. */}
<div class="hands hands-front" data-hands-front aria-hidden="true">
  {
    (["left", "right"] as const).map((side) => (
      <div class:list={["hand", side]} data-hand={`${side}-front`}>
        <svg viewBox="0 0 200 420">
          <defs>
            <linearGradient id={`skin-${side}-front`} x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#c78c64" />
              <stop offset="0.5" stop-color="#e3b18c" />
              <stop offset="1" stop-color="#c78c64" />
            </linearGradient>
          </defs>
          <g transform={side === "right" ? "translate(200 0) scale(-1 1)" : undefined}>
            <g data-thumb>
              <path class="skin" fill={`url(#skin-${side}-front)`} d="M129.5 128 L129.5 77 C129.5 64 135 57.5 140.5 57.5 C146.5 57.5 151.5 64 151.5 77 L151.5 128 Z" />
              <path class="nail" d="M134.5 77 L134.5 68 Q134.5 62.5 140.5 62.5 Q146.5 62.5 146.5 68 L146.5 77 Q140.5 79.5 134.5 77 Z" />
              <path class="crease" d="M135 95 q5.5 2.4 11 0 M136 98 q4.5 1.8 9 0" />
            </g>
          </g>
        </svg>
      </div>
    ))
  }

  <div class="holo" data-holo>
    <svg viewBox="0 0 160 230">
      <defs>
        <linearGradient id="holo-beam" x1="0" y1="1" x2="0" y2="0">
          <stop offset="0" stop-color="#43f24b" stop-opacity="0.5" />
          <stop offset="1" stop-color="#43f24b" stop-opacity="0" />
        </linearGradient>
      </defs>
      <path class="beam" d="M6 228 L28 60 L152 60 L18 228 Z" fill="url(#holo-beam)" />
      {/* Filled from /holo/aliens.json on first use: traced three-tone silhouettes. */}
      <g data-holo-aliens></g>
      <text class="holo-name" x="96" y="16" data-holo-name></text>
    </svg>
  </div>
</div>

<style>
  .hands {
    display: none;
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    --ink: #5a3a28;
    --suit: #1a1a1e;
    --suit-edge: #36363d;
  }

  :global(.deck-ready) .hands {
    display: block;
  }

  /* Under every card, even the ones briefly slipped under the deck. */
  .hands-back {
    z-index: -100;
  }

  .hands-front {
    z-index: 500;
  }

  .hand {
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--hand-w);
    /* Puts the palm's top centre (100, 60 of 200 x 420) on the element's origin. */
    margin-left: calc(var(--hand-w) * -0.5);
    margin-top: calc(var(--hand-w) * -0.3);
    will-change: transform;
  }

  .hand svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* A resting hand notices the pointer (and waves), but only where it is drawn. */
  .hands-back .hand svg {
    pointer-events: visiblePainted;
  }

  /* Fill comes from each shape's gradient; a soft brown outline, not black. */
  .skin {
    stroke: var(--ink);
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  .nail {
    fill: #f1cdb9;
    stroke: #9a6a50;
    stroke-width: 0.9;
  }

  .crease {
    fill: none;
    stroke: var(--ink);
    stroke-width: 0.9;
    stroke-linecap: round;
    opacity: 0.45;
  }

  .tendon {
    fill: none;
    stroke: #a8704c;
    stroke-width: 1.4;
    stroke-linecap: round;
    opacity: 0.35;
  }

  .suit {
    fill: var(--suit);
    stroke: var(--suit-edge);
    stroke-width: 2;
  }

  .suit-seam {
    stroke: var(--suit-edge);
    stroke-width: 1.2;
    stroke-dasharray: 3 4;
  }

  .cuff {
    fill: #f4f3ef;
    stroke: #b9b7b0;
    stroke-width: 1.6;
  }

  .link {
    fill: #ff5a1f;
    stroke: #8f2f0b;
    stroke-width: 1;
  }

  .strap {
    fill: #202024;
    stroke: #0e0e10;
    stroke-width: 1.2;
  }

  .btn {
    fill: #2e2e33;
  }

  .case {
    fill: #25252a;
    stroke: #45454c;
    stroke-width: 1.6;
  }

  .bezel {
    fill: #070708;
  }

  .sec {
    fill: none;
    stroke: #ff5a1f;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  .city {
    fill: #9d9da3;
    font-family: var(--font-mono);
    font-size: 4.6px;
    letter-spacing: 1px;
    text-anchor: middle;
  }

  .time {
    fill: #f4f4f1;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    text-anchor: middle;
  }

  .dial {
    fill: #0b0b0b;
    stroke: #505056;
    stroke-width: 3;
  }

  .dial-ring {
    fill: none;
    stroke: #43f24b;
    stroke-width: 1.4;
    opacity: 0.6;
  }

  .hourglass {
    fill: #43f24b;
    filter: drop-shadow(0 0 3px #43f24b);
  }

  .watch-btn {
    position: absolute;
    left: 37%;
    top: 33.8%;
    width: 26%;
    aspect-ratio: 1;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    pointer-events: auto;
  }

  .watch-btn:focus-visible {
    outline: 2px solid #43f24b;
    outline-offset: 2px;
  }

  .holo {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(var(--hand-w) * 0.85);
    opacity: 0;
    visibility: hidden;
    transform-origin: 0% 100%;
    filter: drop-shadow(0 0 8px rgb(67 242 75 / 0.7));
  }

  .holo svg {
    width: 100%;
    height: auto;
    /* Scan lines, cut out of the projection itself so no box shows around it. */
    mask-image: repeating-linear-gradient(to bottom, #000 0 2.6px, rgb(0 0 0 / 0.35) 2.6px 4px);
  }

  /* Added by the script, so outside this component's scoped styles. */
  .holo :global(.alien) {
    fill: #43f24b;
    opacity: 0;
  }

  .holo-name {
    fill: #43f24b;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-anchor: middle;
  }
</style>
