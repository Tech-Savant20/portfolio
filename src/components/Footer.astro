---
import { getImage } from "astro:assets";
import portrait from "../assets/portrait.png";
import { site } from "../data/site";
import Icon from "./Icon.astro";

const year = new Date().getFullYear();
// Small enough to sample one pixel per character cell, and it keeps the cut-out's alpha.
const ascii = await getImage({ src: portrait, width: 160, format: "webp" });
---

<footer class="footer" data-footer>
  <div class="container-x inner">
    <div class="cols">
      <nav class="col" aria-label="Elsewhere">
        <p class="eyebrow">Elsewhere</p>
        <span class="rise"><a href={`mailto:${site.email}`} data-footer-rise>Email</a></span>
        <span class="rise">
          <a href={site.linkedin} target="_blank" rel="noopener" data-footer-rise>
            LinkedIn
            <Icon name="arrow-up-right" size="0.9rem" class="nudge" />
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </span>
        <span class="rise">
          <a href={site.github} target="_blank" rel="noopener" data-footer-rise>
            GitHub
            <Icon name="arrow-up-right" size="0.9rem" class="nudge" />
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </span>
      </nav>

      <div class="col">
        <p class="eyebrow">Colophon</p>
        <div class="rise">
          <p class="built" data-footer-rise>Built with Astro and Three.js. Runs on Cloudflare Workers.</p>
        </div>
        <span class="rise">
          <a href={site.sourceRepo} target="_blank" rel="noopener" data-footer-rise>
            Source on GitHub
            <Icon name="arrow-up-right" size="0.9rem" class="nudge" />
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </span>
      </div>
    </div>

    {/* The portrait again, this time as characters that light up under the pointer. */}
    <div class="art" data-ascii-wrap aria-hidden="true">
      <canvas data-ascii data-src={ascii.src}></canvas>
    </div>

    <p class="big" data-footer-name>{site.name}</p>

    <div class="base">
      <p>© {year} {site.name} · {site.location}</p>
      <a class="top" href="#main">
        Back to top
        <Icon name="arrow-up" size="0.9rem" class="nudge-up" />
      </a>
    </div>
  </div>
</footer>

<script>
  import { initFooter } from "../scripts/footer";
  initFooter();
</script>

<style>
  .footer {
    display: flex;
    align-items: stretch;
    border-top: 1px solid var(--line);
    background: var(--bg);
    padding-block: clamp(2rem, 4vw, 3rem);
    overflow: hidden;
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(12rem, 24vw, 21rem);
    grid-template-areas:
      "cols art"
      "name art"
      "base base";
    align-content: space-between;
    gap: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3.5rem);
  }

  .cols {
    grid-area: cols;
    display: flex;
    flex-wrap: wrap;
    gap: 2rem clamp(3rem, 8vw, 7rem);
  }

  .col {
    display: grid;
    gap: 0.375rem;
    align-content: start;
  }

  .col .eyebrow {
    margin-bottom: 0.5rem;
  }

  /* Each line rises out of its own slot when the footer is uncovered. */
  .rise {
    display: block;
    overflow: hidden;
  }

  .col a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    width: fit-content;
    font-size: 1.0625rem;
    font-weight: 550;
    transition: color 0.2s ease;
  }

  .col a:hover {
    color: var(--accent-ink);
  }

  .built {
    max-width: 22rem;
    color: var(--fg-muted);
  }

  .art {
    grid-area: art;
    align-self: end;
    /* Reserved before the drawing knows its own height, so nothing jumps. */
    aspect-ratio: 1034 / 954;
  }

  .art canvas {
    width: 100%;
    height: auto;
  }

  .big {
    grid-area: name;
    align-self: end;
    font-size: clamp(2.25rem, 7.6vw, 6.75rem);
    font-weight: 650;
    line-height: 0.9;
    letter-spacing: -0.05em;
  }

  .base {
    grid-area: base;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  .top {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--fg);
    font-weight: 550;
  }

  .top :global(svg) {
    transition: transform 0.4s var(--ease-out);
  }

  .top:hover :global(.nudge-up) {
    transform: translateY(-2px);
  }

  /* Tall enough to fill the screen once the page has slid off it, never taller. */
  @media (min-width: 768px) {
    .footer {
      position: sticky;
      bottom: 0;
      z-index: 0;
      min-height: min(44rem, calc(100svh - var(--nav-h)));
    }
  }

  @media (max-width: 767px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "cols"
        "name"
        "base";
    }

    .art {
      display: none;
    }
  }
</style>
