---
import { Image } from "astro:assets";
import heroPhoto from "../assets/hero-cutout.webp";
import hero from "../data/hero.json";
import { roles, site, type RoleKey } from "../data/site";
import Icon from "./Icon.astro";

interface Props {
  role: RoleKey;
  resume: string | null;
  /** Whether the journey section is on the page, for the "Located in" pill to lead to. */
  journey?: boolean;
}

const { role, resume, journey = false } = Astro.props;
const r = roles[role];
const b = hero.backdrop;
// The photo is a cut-out; the studio wall and the disc behind the head are
// painted here. In the light theme the wall is the photo's own (sampled from
// its edges by `npm run hero`); in the dark theme it's a dark studio.
const vars = [`--photo-top:${b.top}`, `--photo-bottom:${b.bottom}`, `--photo-left:${b.left}`, `--photo-right:${b.right}`].join(";");
const name = `${site.name} —`;
---

<section class="hero" aria-labelledby="hero-name" data-hero style={vars}>
  <div class="photo" data-hero-photo>
    <span class="disc" aria-hidden="true" data-hero-disc></span>
    <Image
      src={heroPhoto}
      alt="Portrait of Abhyuday Tomar"
      widths={[640, 960, 1254]}
      sizes="(min-width: 768px) min(100svh, 100vw), 100vw"
      quality={85}
      priority
    />
    {/* Game mode: rupee signs light up in the lenses. */}
    <span class="rupees" aria-hidden="true">
      {
        ["near", "far"].map((lens) => (
          <svg class:list={["rupee", lens]} viewBox="0 0 24 24">
            <path d="M6 3h12M6 8h12M6 3h3a5 5 0 0 1 0 10H6l9 8" />
          </svg>
        ))
      }
    </span>
  </div>

  <div class="inner container-x">
    {
      journey ? (
        <a class="where" href="#journey" data-magnetic data-hero-where>
          <span class="where-text">
            Located in
            <br />
            {site.location}
          </span>
          <span class="globe" aria-hidden="true">
            <Icon name="globe" size="1.75rem" />
          </span>
        </a>
      ) : (
        <p class="where" data-hero-where>
          <span class="where-text">
            Located in
            <br />
            {site.location}
          </span>
          <span class="globe" aria-hidden="true">
            <Icon name="globe" size="1.75rem" />
          </span>
        </p>
      )
    }

    {/* The disc moves to whatever music is playing nearby. Opt-in: it asks for the
        microphone only when pressed, and the sound never leaves the browser. */}
    <button
      type="button"
      class="vibe"
      aria-pressed="false"
      title="Uses your microphone to hear the beat. Nothing is recorded or sent anywhere."
      data-hero-vibe
      hidden
    >
      <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
      <Icon name="music-notes" size="1.05rem" class="note" />
      <span data-vibe-label>Playing music? Let the circle vibe</span>
    </button>

    <div class="role" data-hero-role>
      <Icon name="arrow-down-right" size="1.75rem" class="arrow" />
      <p class="eyebrow">{site.eyebrow}</p>
      <p class="line" data-hero-line aria-live="polite">
        <strong data-hero-title>{r.heroTitle}</strong>
        <span data-hero-body>{r.heroBody}</span>
      </p>
      <div class="ctas">
        {
          resume && (
            <a class="btn btn-primary" href={resume} target="_blank" rel="noopener" data-resume-link data-magnetic>
              Resume
              <Icon name="arrow-up-right" size="1.05rem" class="nudge" />
              <span class="sr-only">(opens in a new tab)</span>
            </a>
          )
        }
        <a class="btn btn-ghost" href="#contact" data-magnetic>
          Contact
          <Icon name="arrow-down" size="1.05rem" class="nudge-y" />
        </a>
      </div>
    </div>
  </div>

  <h1 id="hero-name" class="sr-only">{site.name}</h1>

  {/* The name, big, running along the bottom. Two copies so it can loop. */}
  <div class="marquee" aria-hidden="true" data-hero-marquee>
    <div class="track" data-hero-track>
      <span class="run">{name}</span>
      <span class="run">{name}</span>
    </div>
  </div>
</section>

<style>
  .hero {
    /* The wall: the photo's own in the light theme, a dark studio in the dark one. */
    --bd-top: var(--photo-top);
    --bd-bottom: var(--photo-bottom);
    --bd-left: var(--photo-left);
    --bd-right: var(--photo-right);
    /* Ink for the wall (global.css), so the nav, buttons and text read on it. */
    --fg: var(--hero-ink);
    --fg-muted: color-mix(in oklab, var(--hero-ink) 72%, transparent);
    --fg-subtle: color-mix(in oklab, var(--hero-ink) 45%, transparent);
    --line: color-mix(in oklab, var(--hero-ink) 16%, transparent);
    --line-strong: color-mix(in oklab, var(--hero-ink) 30%, transparent);
    --surface: var(--hero-surface);
    --bg: var(--bd-top);

    position: relative;
    min-height: 100svh;
    display: flex;
    overflow: clip;
    color: var(--fg);
    background:
      linear-gradient(to right, var(--bd-left), transparent 30%, transparent 70%, var(--bd-right)),
      linear-gradient(to bottom, var(--bd-top), var(--bd-bottom));
  }

  /* The photo stands on the bottom edge and its sides melt into the backdrop.
     The face sits right of centre in the frame, so the photo is shifted to
     bring the face to the middle of the screen. */
  .photo {
    --shift: -60%;
    position: absolute;
    z-index: 0;
    left: 50%;
    bottom: 0;
    height: min(100svh, 100vw * 1.1);
    aspect-ratio: 1;
    transform: translateX(var(--shift));
    -webkit-mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent),
      linear-gradient(to bottom, transparent, #000 10%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent),
      linear-gradient(to bottom, transparent, #000 10%);
    mask-composite: intersect;
    pointer-events: none;
  }

  :global(:root[data-theme="dark"]) .hero {
    --bd-top: #151517;
    --bd-bottom: var(--hero-wall);
    --bd-left: var(--hero-wall);
    --bd-right: var(--hero-wall);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .hero {
      --bd-top: #151517;
      --bd-bottom: var(--hero-wall);
      --bd-left: var(--hero-wall);
      --bd-right: var(--hero-wall);
    }
  }

  .photo :global(img) {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }

  /* Rupee signs in the lenses, placed on the photo (lens centres measured in
     the 1254 px original: near lens 764,546; far lens 945,600). */
  .rupees {
    display: none;
  }

  :global(html.game-mode) .rupees {
    display: block;
  }

  .rupee {
    position: absolute;
    width: 7%;
    translate: -50% -50%;
    fill: none;
    stroke: #ffd23f;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 0.35rem rgb(255 196 0 / 0.9)) drop-shadow(0 0 0.1rem #fff3b0);
  }

  .rupee.near {
    left: 60.9%;
    top: 43.3%;
    rotate: 9deg;
  }

  /* The far lens is turned away, so its sign is narrower. */
  .rupee.far {
    left: 75.3%;
    top: 47.9%;
    width: 5.6%;
    rotate: 14deg;
    scale: 0.7 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.game-mode) .rupee {
      animation:
        rupee-in 0.6s var(--ease-out) both,
        rupee-glint 2.4s ease-in-out 0.6s infinite;
    }

    :global(html.game-mode) .rupee.far {
      animation-delay: 0.08s, 0.9s;
    }
  }

  @keyframes rupee-in {
    from {
      opacity: 0;
      transform: scale(0.2);
    }
  }

  @keyframes rupee-glint {
    50% {
      opacity: 0.7;
    }
  }

  /* The disc behind the head, where it sat in the original photo. --vibe (0-1)
     comes from src/scripts/vibe.ts while music is playing. */
  .disc,
  .photo :global(.ripple) {
    position: absolute;
    left: 2.9%;
    top: 1.2%;
    width: 93.3%;
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .disc {
    --vibe: 0;
    background: var(--hero-disc);
    transform: scale(calc(1 + var(--vibe) * 0.07));
    box-shadow: 0 0 calc(var(--vibe) * 90px) calc(var(--vibe) * 14px) color-mix(in oklab, var(--accent) 55%, transparent);
  }

  /* A ring that leaves the disc on each beat. */
  .photo :global(.ripple) {
    border: 2px solid var(--accent);
    opacity: 0;
    animation: ripple 1s var(--ease-out) forwards;
  }

  @keyframes ripple {
    from {
      opacity: 0.7;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(1.22);
    }
  }

  .vibe {
    position: absolute;
    left: 0;
    /* Just under the "Located in" pill, which is centred in the space
       between the nav and the name. */
    top: calc(var(--nav-h) + (100% - var(--nav-h) - var(--pad-bottom)) / 2 + 4.25rem);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.5rem;
    padding-inline: 1rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: var(--hero-surface);
    color: var(--fg);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease;
  }

  .vibe[hidden] {
    display: none;
  }

  .vibe:hover {
    border-color: var(--fg);
  }

  .vibe[aria-pressed="true"] {
    border-color: var(--accent);
  }

  /* Three bars that bounce while it's listening; the note shows otherwise. */
  .eq {
    display: none;
    align-items: flex-end;
    gap: 2px;
    height: 0.9rem;
  }

  .eq i {
    width: 3px;
    height: 100%;
    border-radius: 1px;
    background: var(--accent);
    transform-origin: bottom;
    animation: eq 0.8s ease-in-out infinite;
  }

  .eq i:nth-child(2) {
    animation-delay: -0.3s;
  }

  .eq i:nth-child(3) {
    animation-delay: -0.55s;
  }

  @keyframes eq {
    50% {
      transform: scaleY(0.3);
    }
  }

  .vibe[aria-pressed="true"] .eq {
    display: inline-flex;
  }

  .vibe[aria-pressed="true"] :global(.note) {
    display: none;
  }

  .inner {
    position: relative;
    z-index: 2;
    width: 100%;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    --pad-bottom: clamp(9rem, 16vw, 16rem);
    padding-top: var(--nav-h);
    padding-bottom: var(--pad-bottom);
  }

  /* "Located in" pill, hanging off the left edge of the screen like a tag:
     it reaches back to the viewport edge from the content column. */
  .where {
    display: inline-flex;
    align-items: center;
    gap: 1.75rem;
    margin-left: calc(50% - 50vw);
    padding: 1.25rem 1.25rem 1.25rem calc(50vw - 50% + 0.25rem);
    border-radius: 0 999px 999px 0;
    background: var(--hero-ink);
    color: var(--bd-top);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.25;
    align-self: center;
  }

  .globe {
    display: grid;
    place-items: center;
    width: 4.25rem;
    height: 4.25rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--bd-top) 80%, transparent);
    color: var(--hero-ink);
  }

  .globe :global(svg) {
    animation: spin 12s linear infinite;
  }

  a.where {
    transition: background-color 0.3s ease;
  }

  a.where:hover {
    background: color-mix(in oklab, var(--hero-ink) 85%, var(--accent));
  }

  /* Narrow enough to stay right of the face at every desktop width. */
  .role {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: min(22rem, 25vw);
  }

  .role :global(.arrow) {
    margin-bottom: 1.5rem;
  }

  .role .eyebrow {
    color: var(--fg-muted);
  }

  .line {
    display: grid;
    gap: 0.5rem;
    font-size: clamp(1rem, 1.25vw, 1.1875rem);
    line-height: 1.4;
    color: var(--fg-muted);
  }

  .line strong {
    font-size: clamp(1.75rem, 2.9vw, 2.75rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--fg);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 0.75rem;
  }

  /* The name. */
  .marquee {
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    bottom: clamp(0.5rem, 2vw, 2rem);
    overflow: hidden;
    pointer-events: none;
  }

  .track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  /* White with "difference" blending: it reads against whatever is behind it,
     dark on the light wall and white over the jacket or the dark wall. */
  .marquee {
    mix-blend-mode: difference;
  }

  .run {
    flex: none;
    padding-right: 0.25em;
    font-size: clamp(5.5rem, 15vw, 17rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
    white-space: nowrap;
    color: #fff;
  }

  /* Before scripts take over the marquee, it runs on CSS alone. */
  :global(html:not(.hero-js)) .track {
    animation: run 26s linear infinite;
  }

  @keyframes run {
    to {
      transform: translateX(-50%);
    }
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track,
    .globe :global(svg) {
      animation: none !important;
    }
  }

  /* Entrance: the photo rises, then the name slides in and the copy fades up. */
  @media (prefers-reduced-motion: no-preference) {
    .photo {
      animation: photo-in 1.4s var(--ease-out) both;
    }

    .marquee {
      animation: name-in 1.3s var(--ease-out) 0.25s both;
    }

    .where,
    .role {
      animation: fade-up 1.1s var(--ease-out) 0.55s both;
    }
  }

  @keyframes photo-in {
    from {
      opacity: 0;
      transform: translate(var(--shift), 6%);
    }
    to {
      opacity: 1;
      transform: translate(var(--shift), 0);
    }
  }

  @keyframes name-in {
    from {
      opacity: 0;
      transform: translateY(40%);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(1rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Phones: copy on top, the photo below it in the flow (so they never
     overlap), the name across the bottom of the photo. */
  @media (max-width: 767px) {
    .hero {
      flex-direction: column;
    }

    .inner {
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 1.25rem;
      min-height: 0;
      padding-top: calc(var(--nav-h) + 1.5rem);
      padding-bottom: 0;
    }

    .photo {
      --shift: -8%;
      order: 2;
      position: relative;
      left: auto;
      bottom: auto;
      width: 116%;
      height: auto;
      margin-top: 1rem;
    }

    .where {
      align-self: flex-start;
      gap: 1rem;
      padding-block: 0.75rem;
      font-size: 0.9375rem;
    }

    .globe {
      width: 3rem;
      height: 3rem;
    }

    .vibe {
      position: static;
      align-self: flex-start;
    }

    .role {
      max-width: none;
      margin: 0;
    }

    .role :global(.arrow) {
      display: none;
    }

    .run {
      font-size: 24vw;
    }
  }
</style>
