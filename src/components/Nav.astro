---
import { roles, type RoleKey } from "../data/site";
import hero from "../data/hero.json";
import Icon from "./Icon.astro";
import MenuPanel from "./MenuPanel.astro";
import RoleSwitcher from "./RoleSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  /** Home pages show the role switcher; case studies show a way back. */
  mode: "home" | "article";
  role?: RoleKey;
  /** Whether the home page has the journey section (for the menu). */
  journey?: boolean;
}

const { mode, role = "backend", journey = false } = Astro.props;
const home = roles[role].path;
const onHome = mode === "home";
const sectionHref = (id: string) => (onHome ? `#${id}` : `${home}#${id}`);
---

<div class="sentinel" data-nav-sentinel aria-hidden="true"></div>
<header class="nav" class:list={{ "has-hero": onHome }} data-nav style={`--hero-ink:${hero.ink}`}>
  <div class="inner container-x">
    {/* "© Code by Abhyuday"; on hover the © turns and the words roll over to the full name. */}
    <a href={home} class="brand" data-home-link>
      <span class="copy" aria-hidden="true">©</span>
      <span class="roll" aria-hidden="true">
        <span class="face">Code by Abhyuday</span>
        <span class="face alt">Abhyuday Tomar</span>
      </span>
      <span class="sr-only">Abhyuday Tomar, home</span>
    </a>

    <div class="center">
      {
        onHome ? (
          <RoleSwitcher role={role} />
        ) : (
          <a href={`${home}#work`} class="back" data-back-link>
            <Icon name="arrow-left" size="1rem" />
            All work
          </a>
        )
      }
    </div>

    <div class="end">
      <nav aria-label="Sections" class="links">
        <a href={sectionHref("work")} data-section-link>Work</a>
        <a href={sectionHref("homelab")} data-section-link>Homelab</a>
        <a href={sectionHref("contact")} data-section-link>Contact</a>
      </nav>
      <button type="button" class="game" data-game-toggle aria-pressed="false" aria-label="Game mode">
        <Icon name="game-controller" size="1.2rem" />
      </button>
      <ThemeToggle />
    </div>
  </div>
</header>
{onHome && <MenuPanel onHome={onHome} home={home} role={role} journey={journey} />}

<script>
  import { initGameMode } from "../scripts/game-mode";
  initGameMode();

  // Solid background once the page has scrolled past the top.
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const sentinel = document.querySelector("[data-nav-sentinel]");
  if (nav && sentinel) {
    new IntersectionObserver(([entry]) => {
      nav.classList.toggle("is-scrolled", !entry.isIntersecting);
    }).observe(sentinel);
  }

  // On case studies, "All work" returns to the view the visitor came from.
  const back = document.querySelector<HTMLAnchorElement>("[data-back-link]");
  if (back) {
    try {
      const path = sessionStorage.getItem("rolePath");
      if (path && ["/", "/cloud", "/ai"].includes(path)) {
        back.href = `${path}#work`;
        document.querySelector<HTMLAnchorElement>("[data-home-link]")?.setAttribute("href", path);
        document.querySelectorAll<HTMLAnchorElement>("[data-section-link]").forEach((link) => {
          link.href = `${path}${link.hash}`;
        });
      }
    } catch {}
  }
</script>

<style>
  .sentinel {
    position: absolute;
    top: 0;
    height: 1px;
    width: 1px;
  }

  /* Stays put while pages transition underneath it. Not during a theme
     switch, where it should be part of the circle reveal like the rest. */
  :global(:root:not(.theme-vt)) .nav {
    view-transition-name: site-nav;
  }

  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-nav);
    height: var(--nav-h);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.4s ease,
      border-color 0.4s ease,
      backdrop-filter 0.4s ease;
  }

  /* Only the standard property: the minifier adds the -webkit- prefix for
     Safari, and writing both made it drop the one Chrome reads. */
  .nav:global(.is-scrolled) {
    background: color-mix(in oklab, var(--bg) 86%, transparent);
    border-bottom-color: var(--line);
    backdrop-filter: blur(16px) saturate(140%);
  }

  @media (prefers-reduced-transparency: reduce) {
    .nav:global(.is-scrolled) {
      background: var(--bg);
      backdrop-filter: none;
    }
  }

  .inner {
    height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  /* Home page: over the hero the bar takes the hero's ink, whatever the theme,
     and has no background; once the hero is gone it slides away (the round
     menu button takes over). */
  .nav.has-hero {
    transition:
      transform 0.6s var(--ease-out),
      background-color 0.4s ease,
      border-color 0.4s ease;
  }

  .nav:global(.on-hero) {
    --fg: var(--hero-ink);
    --fg-muted: color-mix(in oklab, var(--hero-ink) 72%, transparent);
    --line: color-mix(in oklab, var(--hero-ink) 16%, transparent);
    --line-strong: color-mix(in oklab, var(--hero-ink) 30%, transparent);
    --surface: color-mix(in oklab, white 45%, transparent);
    --bg: #f4f4f2;
    color: var(--fg);
    background: transparent !important;
    border-bottom-color: transparent !important;
    backdrop-filter: none !important;
  }

  .nav:global(.is-away) {
    transform: translateY(-100%);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    justify-self: start;
    font-size: 0.9375rem;
    font-weight: 550;
    letter-spacing: -0.01em;
  }

  .copy {
    display: inline-block;
    font-size: 1.05em;
    transition: transform 0.8s var(--ease-out);
  }

  .brand:hover .copy {
    transform: rotate(360deg);
  }

  /* Two lines stacked in a one-line window; hover rolls to the second. */
  .roll {
    display: inline-grid;
    height: 1.25em;
    overflow: hidden;
    line-height: 1.25;
  }

  .face {
    transition: transform 0.6s var(--ease-out);
  }

  .brand:hover .face {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .brand:hover .copy,
    .brand:hover .face {
      transform: none;
    }
  }

  .center {
    display: flex;
    justify-content: center;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.5rem;
    padding-inline: 1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: 0.875rem;
    font-weight: 550;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease;
  }

  .back:hover {
    background: var(--surface);
    border-color: var(--line-strong);
  }

  .end {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .links {
    display: flex;
    gap: 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--fg-muted);
  }

  .links a {
    transition: color 0.2s ease;
  }

  /* Same shape as the theme toggle next to it; lit up while game mode is on. */
  .game {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-right: -0.75rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--fg);
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease,
      color 0.25s ease;
  }

  .game:hover {
    background: var(--surface);
    border-color: var(--line-strong);
  }

  .game[aria-pressed="true"] {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
  }

  .links a:hover {
    color: var(--fg);
  }

  @media (max-width: 1023px) {
    .links {
      display: none;
    }
  }

  @media (max-width: 767px) {
    /* Phones: just the ©, the role switcher needs the room. */
    .roll {
      display: none;
    }

    .copy {
      font-size: 1.5rem;
    }

    .inner {
      grid-template-columns: auto 1fr auto;
      gap: 0.5rem;
    }
  }
</style>
