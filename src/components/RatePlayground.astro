---
/**
 * "Try the rate engine": the LastMile IQ pricing rules, running live in the
 * page (src/lib/rate-engine.ts, checked against the repo's own tests).
 */
---

<div class="play" data-playground>
  <p class="intro">
    The same formulas and seeded rate cards as the live app, running in your browser. Change the parcel and see
    which rule decides the price.
  </p>

  <div class="grid">
    <form class="inputs" data-play-form>
      <fieldset class="dims">
        <legend>Parcel (cm)</legend>
        <label>Length <input type="number" name="l" min="0" max="500" step="1" value="20" inputmode="decimal" /></label>
        <label>Width <input type="number" name="w" min="0" max="500" step="1" value="15" inputmode="decimal" /></label>
        <label>Height <input type="number" name="h" min="0" max="500" step="1" value="10" inputmode="decimal" /></label>
        <label>Weight (kg) <input type="number" name="kg" min="0" max="500" step="0.1" value="0.4" inputmode="decimal" /></label>
      </fieldset>

      <fieldset class="seg">
        <legend>Customer</legend>
        <label><input type="radio" name="order" value="B2C" checked /> <span>B2C</span></label>
        <label><input type="radio" name="order" value="B2B" /> <span>B2B</span></label>
      </fieldset>

      <fieldset class="seg">
        <legend>Route</legend>
        <label><input type="radio" name="zone" value="INTRA_ZONE" checked /> <span>Same zone</span></label>
        <label><input type="radio" name="zone" value="INTER_ZONE" /> <span>Across zones</span></label>
      </fieldset>

      <fieldset class="seg">
        <legend>Payment</legend>
        <label><input type="radio" name="pay" value="PREPAID" checked /> <span>Prepaid</span></label>
        <label><input type="radio" name="pay" value="COD" /> <span>Cash on delivery</span></label>
      </fieldset>

      <label class="declared" data-declared hidden>
        Declared value ($) <input type="number" name="declared" min="0" max="100000" step="1" value="1000" inputmode="decimal" />
      </label>

      <div class="presets">
        <span>The repo's tests:</span>
        <button type="button" data-preset="a">Small box, $60</button>
        <button type="button" data-preset="b">Heavy B2B COD, $645</button>
      </div>
    </form>

    <div class="result" aria-live="polite">
      <dl class="rows" data-play-rows></dl>
      <p class="total"><span>Total</span><strong data-play-total>$0.00</strong></p>
    </div>
  </div>
</div>

<script>
  import { quote, type OrderType, type PaymentType, type ZoneType } from "../lib/rate-engine";

  const root = document.querySelector<HTMLElement>("[data-playground]");
  const form = root?.querySelector<HTMLFormElement>("[data-play-form]");
  const rows = root?.querySelector<HTMLElement>("[data-play-rows]");
  const total = root?.querySelector<HTMLElement>("[data-play-total]");
  const declared = root?.querySelector<HTMLElement>("[data-declared]");

  if (form && rows && total && declared) {
    const num = (name: string) => Math.max(0, Number((form.elements.namedItem(name) as HTMLInputElement).value) || 0);
    const pick = (name: string) => (form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value ?? "");
    const $ = (n: number) => `$${n.toFixed(2)}`;
    const kg = (n: number) => `${n.toFixed(2)} kg`;

    const render = () => {
      const l = num("l"), w = num("w"), h = num("h"), actual = num("kg");
      const orderType = pick("order") as OrderType;
      const zoneType = pick("zone") as ZoneType;
      const paymentType = pick("pay") as PaymentType;
      declared.hidden = paymentType !== "COD";
      const q = quote({ lengthCm: l, widthCm: w, heightCm: h, actualWeightKg: actual, orderType, zoneType, paymentType, declaredValue: num("declared") });
      const c = q.card;
      const lines: [string, string, string?][] = [
        ["Volumetric weight", `${l} × ${w} × ${h} / 5000 = ${kg(q.volumetricWeightKg)}`],
        ["Chargeable weight", `${kg(q.chargeableWeightKg)}`, q.isVolumetricCharged ? "volumetric wins" : "actual weight wins"],
        ["Rate card", `${orderType} · ${zoneType === "INTRA_ZONE" ? "same zone" : "across zones"}: $${c.baseRate} covers ${c.baseWeightKg} kg, $${c.perExtraKgRate} per extra kg`],
        ["Extra weight", q.extraWeightKg > 0 ? `${kg(q.extraWeightKg)} → ${q.extraKgBilled} kg billed (rounded up) × $${c.perExtraKgRate} = ${$(q.extraWeightCharge)}` : "none"],
        ["Shipping", `${$(q.shippingCharge)}${q.minApplied ? ` (minimum charge)` : ""}`],
        ["COD fee", q.codSurcharge ? `${$(q.codSurcharge)} · ${q.codNote}` : q.codNote],
      ];
      rows.innerHTML = lines
        .map(([k, v, chip]) => `<div><dt>${k}</dt><dd>${v}${chip ? ` <span class="chip-rule">${chip}</span>` : ""}</dd></div>`)
        .join("");
      total.textContent = $(q.totalCharge);
    };

    const PRESETS: Record<string, Record<string, string>> = {
      a: { l: "20", w: "15", h: "10", kg: "0.4", order: "B2C", zone: "INTRA_ZONE", pay: "PREPAID", declared: "50" },
      b: { l: "50", w: "40", h: "30", kg: "15", order: "B2B", zone: "INTER_ZONE", pay: "COD", declared: "1000" },
    };
    root?.querySelectorAll<HTMLButtonElement>("[data-preset]").forEach((b) =>
      b.addEventListener("click", () => {
        const p = PRESETS[b.dataset.preset ?? ""];
        for (const [name, value] of Object.entries(p)) {
          const radio = form.querySelector<HTMLInputElement>(`input[name="${name}"][value="${value}"]`);
          if (radio) radio.checked = true;
          else (form.elements.namedItem(name) as HTMLInputElement).value = value;
        }
        render();
      }),
    );

    form.addEventListener("input", render);
    form.addEventListener("submit", (e) => e.preventDefault());
    render();
  }
</script>

<style>
  .play {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
  }

  .intro {
    max-width: 44rem;
    color: var(--fg-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .inputs {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid var(--line);
    background: var(--surface);
  }

  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  legend {
    padding: 0;
    margin-bottom: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-muted);
  }

  .dims {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.625rem;
  }

  .dims label,
  .declared {
    display: grid;
    gap: 0.25rem;
    font-size: 0.8125rem;
    font-weight: 550;
  }

  input[type="number"] {
    width: 100%;
    padding: 0.5rem 0.625rem;
    border-radius: 8px;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    color: var(--fg);
    font: inherit;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }

  input[type="number"]:focus-visible {
    outline: none;
    border-color: var(--accent-ink);
    box-shadow: 0 0 0 3px var(--accent-wash);
  }

  .seg {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .seg legend {
    width: 100%;
  }

  .seg label {
    position: relative;
  }

  .seg input {
    position: absolute;
    opacity: 0;
    inset: 0;
  }

  .seg span {
    display: inline-flex;
    align-items: center;
    height: 2.25rem;
    padding-inline: 0.875rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 0.875rem;
    font-weight: 550;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .seg input:checked + span {
    background: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
  }

  .seg input:focus-visible + span {
    outline: 2px solid var(--accent-ink);
    outline-offset: 2px;
  }

  .presets {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--fg-muted);
  }

  .presets button {
    border: 1px dashed var(--line-strong);
    background: transparent;
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    font-size: 0.8125rem;
    color: var(--fg);
  }

  .presets button:hover {
    border-color: var(--accent-ink);
    color: var(--accent-ink);
  }

  .result {
    display: grid;
    gap: 1rem;
  }

  .rows {
    display: grid;
    margin: 0;
  }

  .rows :global(div) {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
  }

  .rows :global(dt) {
    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  .rows :global(dd) {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .rows :global(.chip-rule) {
    display: inline-block;
    margin-left: 0.375rem;
    padding: 0 0.5rem;
    border-radius: 999px;
    background: var(--accent-wash);
    color: var(--accent-ink);
    font-size: 0.75rem;
  }

  .total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-top: 0.5rem;
  }

  .total span {
    font-weight: 600;
  }

  .total strong {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 650;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 1199px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 480px) {
    .dims {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .rows :global(div) {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
  }
</style>
