---
import { Image } from "astro:assets";
import financeDashboard from "../assets/finance-dashboard.png";
import { projects, smallBuilds } from "../data/projects";
import Icon from "./Icon.astro";

const items = smallBuilds.map((slug) => projects[slug]);

// Only Finance Tracker has a screenshot; the other build rides on its words.
const thumbs = { "finance-tracker": financeDashboard } as Record<string, ImageMetadata | undefined>;
---

<section class="section small" aria-labelledby="small-title" data-section="small">
  <div class="container-x">
    <h2 id="small-title" class="title" data-reveal data-split>Smaller builds</h2>
    <ul class="rows">
      {
        items.map((p) => {
          const link = p.links[0];
          const thumb = thumbs[p.slug];
          return (
            <li class="row" data-reveal data-marquee-row>
              <a class="line" href={link.href} target="_blank" rel="noopener">
                <span class="meta" data-scramble>{`${p.kind}, ${p.period}`}</span>
                <span class="name">{p.name}</span>
                <span class="go">
                  {link.label}
                  <Icon name="arrow-up-right" size="1rem" />
                  <span class="sr-only">(opens in a new tab)</span>
                </span>
                {/* Slides in from whichever edge the pointer crossed. */}
                <span class="band" aria-hidden="true" data-band>
                  <span class="band-inner" data-band-inner>
                    <span class="track">
                      {[0, 1].map(() => (
                        <span class="run">
                          {p.stack.map((s) => (
                            <span class="word">{s}</span>
                          ))}
                          {thumb ? (
                            <Image
                              src={thumb}
                              alt={`${p.name} dashboard listing expenses read from scanned receipts`}
                              widths={[360]}
                              sizes="360px"
                              class="thumb"
                            />
                          ) : (
                            <span class="word dim">and back again</span>
                          )}
                        </span>
                      ))}
                    </span>
                  </span>
                </span>
              </a>
              <div class="body">
                <p class="summary">{p.summary}</p>
                <ul class="stack" aria-label="Built with">
                  {p.stack.map((s) => (
                    <li class="chip">{s}</li>
                  ))}
                </ul>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .small {
    padding-top: 0;
  }

  .title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    letter-spacing: -0.035em;
    margin-bottom: 2rem;
  }

  .rows {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .row {
    border-bottom: 1px solid var(--line);
    padding-bottom: 1.75rem;
  }

  /* The line the marquee covers: everything else in the row stays readable. */
  .line {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.25rem 2rem;
    padding-block: clamp(1.25rem, 2.5vw, 2rem);
    overflow: hidden;
  }

  .meta {
    grid-column: 1;
  }

  .name {
    grid-column: 1;
    font-size: clamp(2rem, 4.4vw, 3.75rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .go {
    grid-column: 2;
    grid-row: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-weight: 550;
    color: var(--fg-muted);
    transition: color 0.2s ease;
  }

  .line:hover .go {
    color: var(--fg);
  }

  .band {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--accent);
    color: var(--on-accent);
    transform: translate3d(0, 101%, 0);
  }

  .band-inner {
    display: block;
    height: 100%;
    transform: translate3d(0, -101%, 0);
  }

  .track {
    display: flex;
    align-items: center;
    height: 100%;
    width: max-content;
    animation: band-scroll 24s linear infinite;
    animation-play-state: paused;
  }

  /* Only runs while the row is under the pointer. */
  .row:global(.is-hover) .track {
    animation-play-state: running;
  }

  @keyframes band-scroll {
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .run {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3rem);
    padding-right: clamp(1.5rem, 3vw, 3rem);
    height: 100%;
  }

  .word {
    font-size: clamp(1.5rem, 3.2vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .word.dim {
    opacity: 0.55;
  }

  .run :global(.thumb) {
    height: 68%;
    width: auto;
    object-fit: cover;
  }

  .body {
    display: grid;
    gap: 0.875rem;
    justify-items: start;
    max-width: 44rem;
  }

  .summary {
    color: var(--fg-muted);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  @media (max-width: 767px) {
    .line {
      grid-template-columns: minmax(0, 1fr);
    }

    .go {
      grid-column: 1;
      grid-row: auto;
      margin-top: 0.5rem;
    }
  }
</style>
