---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import "../styles/global.css";
import { site } from "../data/site";
import Terminal from "../components/Terminal.astro";
import Icon from "../components/Icon.astro";

interface Props {
  title: string;
  description: string;
  /** Path of this page, used for the canonical URL. */
  path: string;
  /** OG image path under /og/. */
  image?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const { title, description, path, image = "/og/backend.jpg", jsonLd, noindex = false } = Astro.props;
const canonical = new URL(path, site.url).href;
const ogImage = new URL(image, site.url).href;
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} data-canonical />
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="theme-color" content="#f2f2ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d0e" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} data-og-title />
    <meta property="og:description" content={description} data-og-description />
    <meta property="og:url" content={canonical} data-og-url />
    <meta property="og:image" content={ogImage} data-og-image />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />

    <!-- Runs before first paint: applies a saved theme and marks JS as available. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add("js");
        try {
          const saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") root.dataset.theme = saved;
          if (localStorage.getItem("game-mode") === "on") root.classList.add("game-mode");
        } catch {}
      })();
    </script>

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- Cross-page transitions. Inline on purpose: Chrome drops the opt-in when
         it only lives in the bundled stylesheet and page scripts run first. -->
    <style is:inline>@view-transition{navigation:auto}</style>
    <slot name="head" />
  </head>
  <body>
    <slot name="overlay" />
    <a href="#main" class="skip-link">Skip to content</a>
    <slot name="nav" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <slot name="footer" />
    <Terminal />
    {/* Game mode's HUD: your aura, the secrets as quests, and the way in to
        the casino. Hidden unless game mode is on (game-mode.ts fills it). */}
    {
      path !== "/casino" && (
        <div class="game-hud" data-game-hud role="region" aria-label="Game mode">
          <span class="hud-player" aria-hidden="true">P1</span>
          <a class="hud-stat" href="/casino" data-hud-aura title="Your aura this week">
            <span class="hud-glyph" aria-hidden="true">◆</span>
            <span data-hud-aura-value>1,000</span>
            <span class="hud-unit">aura</span>
          </a>
          <button class="hud-stat" type="button" data-hud-quest title="Next quest">
            <span class="hud-glyph" aria-hidden="true">★</span>
            <span data-hud-secrets>0 / 6</span>
            <span class="hud-unit">quests</span>
          </button>
          <a class="hud-play" href="/casino">
            <Icon name="cards" size="1.05rem" />
            Play blackjack
            <Icon name="arrow-right" size="0.95rem" />
          </a>
        </div>
      )
    }

    {
      beaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: beaconToken, spa: true })}
        />
      )
    }
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: var(--z-skip);
    padding: 0.625rem 1rem;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font-size: 0.875rem;
    font-weight: 550;
    transform: translateY(-200%);
    transition: transform 0.3s var(--ease-out);
  }

  .skip-link:focus-visible {
    transform: none;
  }

  main:focus {
    outline: none;
  }

  .game-hud {
    position: fixed;
    left: 50%;
    bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
    z-index: calc(var(--z-nav) - 1);
    display: none;
    align-items: center;
    gap: 0.25rem;
    max-width: calc(100% - 1.5rem);
    padding: 0.3125rem;
    border-radius: 999px;
    background: #16121f;
    color: #efe9ff;
    border: 1px solid rgb(168 85 247 / 0.45);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    box-shadow:
      0 0 0 4px rgb(168 85 247 / 0.12),
      0 14px 34px -12px rgb(88 28 135 / 0.7);
    transform: translateX(-50%);
  }

  :global(html.game-mode) .game-hud {
    display: inline-flex;
    animation: hud-in 0.6s var(--ease-out) both;
  }

  @keyframes hud-in {
    from {
      opacity: 0;
      transform: translate(-50%, 1.5rem);
    }
  }

  .hud-player {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: #a855f7;
    color: #fff;
    font-weight: 700;
    letter-spacing: 0.04em;
    animation: hud-blink 1.6s steps(1) infinite;
  }

  @keyframes hud-blink {
    50% {
      background: #7e22ce;
    }
  }

  .hud-stat {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 2.25rem;
    padding-inline: 0.75rem;
    border-radius: 999px;
    color: inherit;
    background: none;
    border: 0;
    font: inherit;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s ease;
  }

  .hud-stat:hover,
  .hud-stat:focus-visible {
    background: rgb(168 85 247 / 0.2);
  }

  .hud-glyph {
    color: #c084fc;
  }

  .hud-unit {
    color: #a99bc4;
  }

  .hud-play {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.25rem;
    padding-inline: 1rem;
    border-radius: 999px;
    background: #a855f7;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .hud-play:hover {
    background: #9333ea;
  }

  @media (max-width: 560px) {
    .hud-unit,
    .hud-player {
      display: none;
    }

    .hud-stat {
      padding-inline: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hud-player {
      animation: none;
    }
  }
</style>
