---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Icon from "../components/Icon.astro";
import { projects, caseStudySlugs } from "../data/projects";
---

<Base title="Page not found | Abhyuday Tomar" description="This page doesn't exist." path="/404" noindex>
  <Nav slot="nav" mode="article" />
  <section class="nf container-x">
    <p class="code">404</p>
    <h1>This page doesn't exist.</h1>
    <p class="lede">The link may be old, or mistyped. These are the pages that do:</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">
        Home
        <Icon name="arrow-right" size="1.05rem" class="nudge-x" />
      </a>
      {
        caseStudySlugs.map((slug) => (
          <a class="btn btn-ghost" href={`/work/${slug}`}>
            {projects[slug].name}
          </a>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5rem;
    padding-top: var(--nav-h);
  }

  .code {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--accent-ink);
  }

  h1 {
    font-size: clamp(2.75rem, 8vw, 6.5rem);
    letter-spacing: -0.05em;
    line-height: 0.95;
    max-width: 14ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
</style>
