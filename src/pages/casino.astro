---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import DealerHands from "../components/DealerHands.astro";
import Icon from "../components/Icon.astro";
import { site } from "../data/site";
import { MAX_BET, MIN_BET, REFILL_AURA, START_AURA } from "../lib/blackjack";

const TEST_SITEKEY = "1x00000000000000000000AA";
const sitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? (import.meta.env.DEV ? TEST_SITEKEY : site.turnstileSitekey);
const chips = [10, 25, 50, 100, 250];
---

<Base
  title="The Aura Casino | Abhyuday Tomar"
  description="Blackjack for aura points, dealt by the same hands as the certificate deck. Just for fun: nothing to buy, nothing to win."
  path="/casino"
  noindex
>
  <Nav slot="nav" mode="article" />

  <article class="casino container-x" data-casino>
    <header class="head">
      <p class="eyebrow">Game mode · Blackjack</p>
      <h1>The Aura Casino</h1>
      <p class="lede">
        Everyone starts the week on {START_AURA.toLocaleString("en-IN")} aura. The dealer deals and scores every hand on
        the server, so the leaderboard is real. <strong>Aura is just for fun: nothing to buy, nothing to win.</strong>
      </p>
    </header>

    <div class="layout">
      <section class="table-wrap" aria-label="Blackjack table">
        {/* The felt. Cards and the dealer's hands live on this stage. */}
        <div class="felt deck-ready" data-casino-stage>
          <div class="shoe" aria-hidden="true" data-shoe>
            <span></span><span></span><span></span>
          </div>

          <div class="zone dealer-zone">
            <p class="zone-label">Dealer <span class="total" data-dealer-total></span></p>
            <div class="cards" data-dealer-cards></div>
          </div>

          <p class="banner" role="status" aria-live="polite" data-banner></p>

          <div class="zone player-zone">
            <div class="cards" data-player-cards></div>
            <p class="zone-label">You <span class="total" data-player-total></span></p>
          </div>

          {/* Your bet, as chips in the betting circle. Winnings land beside it. */}
          <div class="bet-spot" aria-hidden="true" data-bet-spot>
            <span class="spot-ring">Bet</span>
            <div class="stack" data-bet-stack></div>
            <div class="stack win" data-win-stack></div>
            <span class="spot-amount" data-bet-amount></span>
          </div>

          <DealerHands />

          {/* Joining: a name and a quick check, once. */}
          <form class="join" data-join hidden>
            <h2>Take a seat</h2>
            <p>Pick a name for the leaderboard. It's the only thing we keep.</p>
            <label class="field">
              <span>Nickname</span>
              <input
                name="nickname"
                required
                minlength="3"
                maxlength="16"
                pattern="[A-Za-z0-9 _\-]{3,16}"
                autocomplete="nickname"
                placeholder="e.g. Ben 10"
              />
            </label>
            <div class="turnstile" data-turnstile data-sitekey={sitekey}></div>
            <p class="join-error" data-join-error hidden></p>
            <button type="submit" class="btn btn-primary" data-join-submit>
              Sit down with {START_AURA.toLocaleString("en-IN")} aura
              <Icon name="arrow-right" size="1.05rem" class="nudge-x" />
            </button>
          </form>

          <p class="loading" data-loading>Shuffling…</p>
        </div>

        {/* Your bet and your moves. */}
        <div class="controls" data-controls>
          <div class="wallet">
            <p class="aura"><span data-aura>–</span> <small>aura</small></p>
            <p class="me" data-me></p>
          </div>

          <div class="betting" data-betting>
            <div class="chips" role="group" aria-label="Add to your bet">
              {
                chips.map((c) => (
                  <button type="button" class="chip" data-chip={c} aria-label={`Add ${c}`}>
                    {c}
                  </button>
                ))
              }
            </div>
            <p class="bet">Bet <strong data-bet>0</strong></p>
            <div class="row">
              <button type="button" class="btn btn-ghost small" data-clear>Clear</button>
              <button type="button" class="btn btn-primary" data-deal>Deal</button>
            </div>
          </div>

          <div class="actions" data-actions hidden>
            <button type="button" class="btn btn-primary" data-act="hit">Hit</button>
            <button type="button" class="btn btn-ghost" data-act="stand">Stand</button>
            <button type="button" class="btn btn-ghost" data-act="double">Double</button>
          </div>

          <button type="button" class="btn btn-ghost refill" data-refill hidden>
            Out of aura: take {REFILL_AURA} (once a day)
          </button>
        </div>
      </section>

      <aside class="board" aria-labelledby="board-title">
        <h2 id="board-title">This week</h2>
        <p class="season" data-season></p>
        <ol class="top" data-top>
          <li class="empty">No hands played yet this week.</li>
        </ol>
        <p class="champion" data-champion hidden></p>

        <details class="rules">
          <summary>House rules</summary>
          <ul>
            <li>Bets {MIN_BET}–{MAX_BET} aura, in steps of 5.</li>
            <li>Blackjack pays 3:2. A win pays 1:1. Ties push.</li>
            <li>The dealer stands on all 17s and checks for blackjack first.</li>
            <li>Double on your first two cards: one more card, twice the bet.</li>
            <li>No split, no insurance. One deck, reshuffled when it runs low.</li>
            <li>Seasons reset every Monday (India time); the top player is crowned champion.</li>
          </ul>
        </details>
      </aside>
    </div>
  </article>

  {/* One card back, cloned for every card dealt: the same casino lattice as the deck. */}
  <template data-card-back>
    <svg viewBox="0 0 100 140" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <pattern id="lattice-casino" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <path d="M0 0 H6 M0 0 V6" stroke="rgb(255 90 31 / .38)" stroke-width=".5"></path>
        </pattern>
      </defs>
      <rect width="100" height="140" fill="#161518"></rect>
      <rect x="9" y="9" width="82" height="122" rx="3" fill="url(#lattice-casino)"></rect>
      <rect x="4" y="4" width="92" height="132" rx="6" fill="none" stroke="rgb(255 90 31 / .8)" stroke-width="1.1"></rect>
      <ellipse cx="50" cy="70" rx="16" ry="20" fill="#161518" stroke="#ff5a1f" stroke-width=".8"></ellipse>
      <text x="50" y="73.4" text-anchor="middle" font-family="Geist Mono Variable, monospace" font-size="9" fill="#ff5a1f">AT</text>
    </svg>
  </template>

  <Footer slot="footer" />
</Base>

<script>
  import { initCasino } from "../scripts/casino";
  initCasino();
</script>

<style>
  .casino {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: calc(var(--nav-h) + clamp(2rem, 6vw, 4.5rem));
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .head {
    display: grid;
    gap: 0.75rem;
    max-width: 46rem;
  }

  .eyebrow {
    color: var(--accent-ink);
  }

  h1 {
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .lede {
    color: var(--fg-muted);
  }

  .lede strong {
    color: var(--fg);
    font-weight: 550;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 20rem);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
  }

  /* ---- the felt ---- */
  .felt {
    --card-w: clamp(4.25rem, 8vw, 6.5rem);
    --hand-w: calc(var(--card-w) * 0.95);
    position: relative;
    isolation: isolate;
    height: clamp(30rem, 44vw, 36rem);
    border-radius: 28px 28px 200px 200px / 28px 28px 90px 90px;
    background:
      radial-gradient(ellipse at 50% 35%, #1f6b3e 0%, #14482a 55%, #0d3320 100%);
    box-shadow:
      inset 0 0 0 10px #3a2417,
      inset 0 0 0 12px #6b4428,
      inset 0 0 60px rgb(0 0 0 / 0.5),
      var(--shadow);
    overflow: hidden;
    color: #f2f2ef;
  }

  .shoe {
    position: absolute;
    top: 1.25rem;
    right: 1.75rem;
    width: calc(var(--card-w) * 0.8);
    aspect-ratio: 5 / 7;
  }

  .shoe span {
    position: absolute;
    inset: 0;
    border-radius: 8px;
    background: #161518;
    border: 1px solid rgb(255 90 31 / 0.6);
  }

  .shoe span:nth-child(2) {
    transform: translate(-3px, 3px);
  }

  .shoe span:nth-child(3) {
    transform: translate(-6px, 6px);
  }

  .zone {
    position: absolute;
    left: 0;
    right: 0;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
  }

  .dealer-zone {
    top: 1.5rem;
  }

  .player-zone {
    bottom: clamp(3.5rem, 7vw, 5rem);
  }

  .zone-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(242 242 239 / 0.7);
  }

  .total {
    display: inline-block;
    min-width: 2ch;
    margin-left: 0.4rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.35);
    color: #fff;
  }

  .total:empty {
    display: none;
  }

  .cards {
    position: relative;
    height: calc(var(--card-w) * 1.4);
    width: 100%;
  }

  .banner {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    padding: 0.5rem 1.25rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.45);
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
  }

  .banner:global(.good) {
    color: #7dffa3;
  }

  .banner:global(.bad) {
    color: #ff8a7a;
  }

  .loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: rgb(242 242 239 / 0.7);
  }

  .loading[hidden] {
    display: none;
  }

  /* Playing cards, built by the script. */
  .felt :global(.pc) {
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--card-w);
    aspect-ratio: 5 / 7;
    margin-left: calc(var(--card-w) / -2);
    perspective: 900px;
    z-index: 5;
  }

  .felt :global(.pc-inner) {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
  }

  .felt :global(.pc-face),
  .felt :global(.pc-back) {
    position: absolute;
    inset: 0;
    border-radius: 9px;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    box-shadow: 0 8px 18px -8px rgb(0 0 0 / 0.6);
    overflow: hidden;
  }

  .felt :global(.pc-back) {
    transform: rotateY(180deg);
  }

  .felt :global(.pc-back svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .felt :global(.pc-face) {
    background: #fbfaf6;
    color: #16161a;
    display: grid;
    place-items: center;
  }

  .felt :global(.pc-face.red) {
    color: #c8281e;
  }

  .felt :global(.pc-corner) {
    position: absolute;
    display: grid;
    justify-items: center;
    line-height: 1;
    font-weight: 650;
    font-size: calc(var(--card-w) * 0.2);
  }

  .felt :global(.pc-corner.tl) {
    top: 6%;
    left: 8%;
  }

  .felt :global(.pc-corner.br) {
    bottom: 6%;
    right: 8%;
    transform: rotate(180deg);
  }

  .felt :global(.pc-corner small) {
    font-size: 0.8em;
  }

  .felt :global(.pc-pip) {
    font-size: calc(var(--card-w) * 0.46);
    line-height: 1;
  }

  /* ---- the betting circle and its chips ---- */
  .bet-spot {
    --chip: calc(var(--card-w) * 0.52);
    position: absolute;
    z-index: 3;
    left: max(calc(var(--card-w) * 0.7), calc(50% - var(--card-w) * 2.6));
    bottom: calc(clamp(3.5rem, 7vw, 5rem) + var(--card-w) * 0.25);
    width: calc(var(--card-w) * 0.9);
    aspect-ratio: 1;
    margin-left: calc(var(--card-w) * -0.45);
  }

  .spot-ring {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 2px dashed rgb(242 242 239 / 0.35);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(242 242 239 / 0.45);
  }

  .stack {
    position: absolute;
    left: 50%;
    top: 50%;
  }

  /* Winnings stack up just to the right of the bet. */
  .stack.win {
    left: calc(50% + var(--chip) * 1.1);
  }

  .spot-amount {
    position: absolute;
    left: 50%;
    top: calc(100% + 0.4rem);
    transform: translateX(-50%);
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.4);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
  }

  .spot-amount:empty {
    display: none;
  }

  .felt :global(.tchip) {
    --c: #ff5a1f;
    position: absolute;
    left: calc(var(--chip) / -2);
    top: calc(var(--chip) / -2);
    display: grid;
    place-items: center;
    width: var(--chip);
    height: var(--chip);
    border-radius: 50%;
    border: 3px dashed rgb(255 255 255 / 0.85);
    background: var(--c);
    color: #fff;
    font-family: var(--font-mono);
    font-size: calc(var(--chip) * 0.28);
    font-weight: 700;
    box-shadow:
      0 0 0 2px var(--c),
      0 3px 0 1px rgb(0 0 0 / 0.35);
  }

  .felt :global(.tchip.c5) {
    --c: #e7e5df;
    color: #16161a;
    border-color: rgb(22 22 26 / 0.5);
  }

  .felt :global(.tchip.c10) {
    --c: #ff5a1f;
    color: #16161a;
  }

  .felt :global(.tchip.c25) {
    --c: #2563eb;
  }

  .felt :global(.tchip.c50) {
    --c: #16a34a;
  }

  .felt :global(.tchip.c100) {
    --c: #111;
  }

  .felt :global(.tchip.c250) {
    --c: #9333ea;
  }

  /* ---- joining ---- */
  .join {
    position: absolute;
    z-index: 600;
    inset: 12% 16%;
    display: grid;
    align-content: center;
    gap: 0.875rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: 20px;
    background: rgb(12 30 20 / 0.92);
    backdrop-filter: blur(6px);
    border: 1px solid rgb(255 255 255 / 0.1);
  }

  .join[hidden] {
    display: none;
  }

  .join h2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .join p {
    color: rgb(242 242 239 / 0.75);
    font-size: 0.9375rem;
  }

  .field {
    display: grid;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 550;
  }

  .field input {
    height: 2.75rem;
    padding-inline: 0.875rem;
    border-radius: 10px;
    border: 1px solid rgb(255 255 255 / 0.2);
    background: rgb(255 255 255 / 0.06);
    color: #fff;
    font: inherit;
    font-size: 1rem;
  }

  .field input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  .join-error {
    color: #ff8a7a;
    font-size: 0.875rem;
  }

  .join .btn {
    justify-self: start;
  }

  /* ---- controls ---- */
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .aura {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 650;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .aura small {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--fg-muted);
  }

  .me {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-muted);
  }

  .betting,
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .betting[hidden],
  .actions[hidden],
  .refill[hidden] {
    display: none;
  }

  .chips {
    display: flex;
    gap: 0.375rem;
  }

  .chip {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 3px dashed rgb(255 255 255 / 0.85);
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    box-shadow: 0 0 0 2px var(--accent);
    transition: transform 0.2s var(--ease-out);
  }

  .chip:nth-child(2) {
    background: #2563eb;
    box-shadow: 0 0 0 2px #2563eb;
    color: #fff;
  }

  .chip:nth-child(3) {
    background: #16a34a;
    box-shadow: 0 0 0 2px #16a34a;
    color: #fff;
  }

  .chip:nth-child(4) {
    background: #111;
    box-shadow: 0 0 0 2px #111;
    color: #fff;
  }

  .chip:nth-child(5) {
    background: #9333ea;
    box-shadow: 0 0 0 2px #9333ea;
    color: #fff;
  }

  .chip:hover:not(:disabled) {
    transform: translateY(-3px);
  }

  .chip:disabled {
    opacity: 0.35;
  }

  .bet {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  .bet strong {
    color: var(--fg);
    font-size: 1.125rem;
  }

  .row {
    display: flex;
    gap: 0.5rem;
  }

  .btn.small {
    height: 2.5rem;
    padding-inline: 1rem;
  }

  .btn:disabled {
    opacity: 0.45;
    pointer-events: none;
  }

  /* ---- the board ---- */
  .board {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    background: var(--surface);
    position: sticky;
    top: calc(var(--nav-h) + 1.5rem);
  }

  .board h2 {
    font-size: 1.25rem;
  }

  .season {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-muted);
  }

  .top {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: rank;
  }

  .top :global(li) {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.45rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
  }

  .top :global(li.empty) {
    display: block;
    color: var(--fg-muted);
    font-size: 0.875rem;
  }

  .top :global(li.you) {
    color: var(--accent-ink);
    font-weight: 600;
  }

  .top :global(.r) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-muted);
  }

  .top :global(.n) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .top :global(.a) {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .champion {
    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  .rules summary {
    cursor: pointer;
    font-weight: 550;
    font-size: 0.9375rem;
  }

  .rules ul {
    display: grid;
    gap: 0.375rem;
    margin: 0.75rem 0 0;
    padding-left: 1.1rem;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }

  @media (max-width: 1023px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .board {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .felt {
      height: 30rem;
      border-radius: 20px 20px 120px 120px / 20px 20px 60px 60px;
    }

    .join {
      inset: 6% 5%;
    }

    .chip {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>
