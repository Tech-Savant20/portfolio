{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abhyudaytomar",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",

  // The static site. Only /api/* reaches the Worker; everything else is served
  // straight from the asset store, with headers from dist/_headers.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  // Latest homelab status, pushed by a cron job on the home server every 2 minutes
  // (720 writes a day, inside the free plan's 1,000). Created on first deploy.
  "kv_namespaces": [{ "binding": "STATUS" }],

  // Contact form mail. Locked to one sender and one destination, so the Worker
  // can never be used to email anyone else.
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "abhyudaytomar1@gmail.com",
      "allowed_sender_addresses": ["contact@abhyudaytomar.com"]
    }
  ],

  // At most 5 contact submissions a minute per visitor IP.
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],

  "vars": {
    "CONTACT_TO": "abhyudaytomar1@gmail.com",
    "CONTACT_FROM": "contact@abhyudaytomar.com",
    // Hostnames Turnstile tokens may come from. Local dev overrides this in .dev.vars.
    "TURNSTILE_HOSTNAMES": "abhyudaytomar.com,www.abhyudaytomar.com"
  },
  // Secrets, set with `wrangler secret put`: TURNSTILE_SECRET, STATUS_TOKEN

  "routes": [
    { "pattern": "abhyudaytomar.com", "custom_domain": true },
    { "pattern": "www.abhyudaytomar.com", "custom_domain": true }
  ],

  "observability": { "enabled": true }
}
