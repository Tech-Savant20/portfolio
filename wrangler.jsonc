{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abhyudaytomar",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",

  // The static site. Only /api/* reaches the Worker; everything else is served
  // straight from the asset store, with headers from dist/_headers.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  // Homelab status. Jarvis and vault-server each push their Uptime Kuma results
  // every 2 minutes: the latest report per server (latest_status) and daily
  // uptime counts per service for /status (uptime_daily, one row per service
  // per IST day). Schema in worker/migrations.
  "d1_databases": [
    {
      "binding": "UPTIME",
      "database_name": "abhyudaytomar-uptime",
      "database_id": "e95912db-159e-4355-bbfd-9adfaf8e7b33",
      "migrations_dir": "worker/migrations"
    }
  ],

  // Contact form mail. Locked to one sender and one destination, so the Worker
  // can never be used to email anyone else.
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "abhyudaytomar1@gmail.com",
      "allowed_sender_addresses": ["contact@abhyudaytomar.com"]
    }
  ],

  // At most 5 contact submissions a minute per visitor IP.
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],

  "vars": {
    "CONTACT_TO": "abhyudaytomar1@gmail.com",
    "CONTACT_FROM": "contact@abhyudaytomar.com",
    // Hostnames Turnstile tokens may come from. Local dev overrides this in .dev.vars.
    "TURNSTILE_HOSTNAMES": "abhyudaytomar.com,www.abhyudaytomar.com"
  },
  // Secrets, set with `wrangler secret put`: TURNSTILE_SECRET, STATUS_TOKEN,
  // and, for the Supabase archive of contact messages, SUPABASE_URL and
  // SUPABASE_SECRET_KEY. Without those two the form only emails.

  "routes": [
    { "pattern": "abhyudaytomar.com", "custom_domain": true },
    { "pattern": "www.abhyudaytomar.com", "custom_domain": true }
  ],

  "observability": { "enabled": true }
}
